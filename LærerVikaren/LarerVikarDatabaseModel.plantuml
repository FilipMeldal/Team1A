Class Management_Gunbritt <<table>>
{
    <<PK>> <<surrogate>> ManagementID : int
    Name : NVarChar(255)
    Email : NVarChar(255)
    Phone : NVarChar(255)
    --
    <<PK>> PK_Management()
}
CLass SUBSTITUTE_MANAGMENT_GUNBRITT <<table>>
{
    <<PK>> <<FK1>> SubstituteID : int
    <<PK>> <<FK2>> ManagementID : int
    --
    <<PK>> PK_SubstituteManagement()
    <<FK1>> FK_SubstituteManagement_Substitute(SubstituteID)
    <<FK2>> FK_SubstituteManagement_Management(ManagementID)
}

@enduml