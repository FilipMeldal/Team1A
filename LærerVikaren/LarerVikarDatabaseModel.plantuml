@startuml
hide circle
hide empty members





SUBSTITUTE_MANAGMENT_GUNBRITT "1..*" -- "1..*" Management_Gunbritt
SUBSTITUTE_MANAGMENT_GUNBRITT "1..*" -- "1..*" Substitute


Class Substitute <<table>>
{
   <<PK>> <<surrogate>> SubstituteID : int
    Name : NVarChar(255)
    Phone : NVarChar(255)
    Subject : NVarChar(255)
    Cpr : int
    Age : int
    
    <<PK>> PK_Substitute()
}

